{
  "name": "sisaku",
  "version": "0.1.0",
  "private": true,
  "description": "Sisaku: prep recommendations and waste reporting for commercial kitchens",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.12.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^5.1.1"
  }
}
