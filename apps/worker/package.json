{
  "name": "@sisaku/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./queue": "./src/queue.ts",
    "./settings": "./src/settings.ts"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "pipeline:run": "tsx --env-file-if-exists=../../.env src/pipeline-run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anvia/core": "1.21.0",
    "@sisaku/agents": "workspace:*",
    "@sisaku/db": "workspace:*",
    "bullmq": "6.7.7",
    "drizzle-orm": "^0.45.2",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anvia/mcp": "1.2.7",
    "@sisaku/kitchen-mcp": "workspace:*",
    "tsx": "^4.19.0"
  }
}
