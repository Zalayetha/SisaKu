# Copy to .env for local development. Never commit .env or real values.
# Names only: set real values in a local .env or the VPS secret store.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Redis (BullMQ)
REDIS_URL=

# Qdrant (RAG vectors)
QDRANT_URL=

# Telegram bot (Anvia Channel), added with the Copilot issue
TELEGRAM_BOT_TOKEN=

# LLM provider key, added with the agent issues
LLM_API_KEY=

# Anvia Lens tracing, added with the observability issue
ANVIA_LENS_URL=
