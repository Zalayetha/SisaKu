# Copy to .env for local development. Never commit .env or real values.
# Names only: set real values in a local .env or the VPS secret store.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Test database for DB-backed tests; its name must end in _test (tests wipe it)
TEST_DATABASE_URL=

# Redis (BullMQ)
REDIS_URL=

# Qdrant (RAG vectors)
QDRANT_URL=

# kitchen-mcp HTTP transport (stdio needs only DATABASE_URL); port defaults to 3001
KITCHEN_MCP_TOKEN=
KITCHEN_MCP_PORT=

# Telegram bot (Anvia Channel), added with the Copilot issue
TELEGRAM_BOT_TOKEN=

# LLM provider key, added with the agent issues
LLM_API_KEY=

# Anvia Lens tracing, added with the observability issue
ANVIA_LENS_URL=
