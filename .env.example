# Copy to .env for local development. Never commit .env or real values.
# Names only: set real values in a local .env or the VPS secret store.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Test database for DB-backed tests; its name must end in _test (tests wipe it)
TEST_DATABASE_URL=

# Redis (BullMQ): the nightly pipeline worker, `pnpm pipeline:run` and `pnpm board`
REDIS_URL=

# Bull Board (pnpm board): refuses to start without the password. User defaults to "operator", port
# to 3003, host to 127.0.0.1. In a container set API_HOST=0.0.0.0 and publish the port to the host's
# loopback only (127.0.0.1:3003:3003); reach it through a tunnel (#42).
BULL_BOARD_PASSWORD=
BULL_BOARD_USER=
API_HOST=
API_PORT=

# Test Redis for the pipeline tests; they only touch keys under a prefix of their own, which they
# pass to the processes they start as PIPELINE_REDIS_PREFIX. Leave that unset everywhere else.
TEST_REDIS_URL=

# Qdrant (RAG vectors)
QDRANT_URL=

# kitchen-mcp HTTP transport (stdio needs only DATABASE_URL); port defaults to 3001
KITCHEN_MCP_TOKEN=
KITCHEN_MCP_PORT=
# impact-mcp HTTP transport (start:http refuses to start without the token; port defaults to 3002)
IMPACT_MCP_TOKEN=
IMPACT_MCP_PORT=
# Copilot: set these to reach the MCP servers over HTTP (deploy); unset, it spawns them over stdio
KITCHEN_MCP_URL=
IMPACT_MCP_URL=
# Optional Open-Meteo MCP server for the worker's Forecast step (ADR 0019); unset, spawns stdio
WEATHER_MCP_URL=
WEATHER_MCP_TOKEN=
# "strict" (default) blocks private addresses; "disabled" when the URLs are Docker service names
MCP_SSRF_PROTECTION=

# Telegram bot (Anvia Channel, polling)
TELEGRAM_BOT_TOKEN=
# Where the Copilot writes confirmed waste photos (ADR 0010); must exist and be writable.
# Locally e.g. the absolute path of .data/photos; on the VPS the photos-data volume mount.
PHOTOS_DIR=

# LLM provider (OpenAI-compatible) for the Copilot and the worker, which refuse to start without a
# key. Base URL optional; model defaults to gpt-5.6.luna
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# Anvia Lens tracing (the Copilot and the worker refuse to start without all three).
# Run Lens from infra/lens (base URL locally: http://localhost:8080) and create keys in its UI.
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
