# Copy to .env (never commit it). Names only: real values live in .env or the VPS secret store.
# Full list of optional settings: https://docs.anvia.dev/lens/self-hosting/configuration.html

# Pinned Lens release (images ghcr.io/anvia-hq/lens and lens-web). Upgrade by bumping it.
LENS_VERSION=0.19.0

# Browser-facing origin; both must match exactly (scheme and port).
# Local: http://localhost:8080   VPS: https://lens.<domain>
PUBLIC_APP_URL=
WEB_ORIGIN=
# Host binding for the web UI. Keep it on 127.0.0.1; the VPS reverse proxy forwards to it.
WEB_PORT=127.0.0.1:8080

# Generate each with: openssl rand -hex 32 (unique per value)
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
# At least 32 characters; changing it signs everyone out
BETTER_AUTH_SECRET=
# At least 16 characters; changing it invalidates every ingestion key
INGESTION_KEY_PEPPER=

# Optional password-reset email; empty disables it
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
